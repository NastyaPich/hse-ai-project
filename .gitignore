# Данные: CSV и большие файлы в git не храним (см. README.md, раздел «Данные»)
*.csv
# небольшие таблицы с результатами экспериментов храним
!reports/*.csv
*.pkl
*.parquet
*.xlsx
data/raw/london/
data/external/
data/processed/
# обученные модели (большие файлы, пересоздаются: python src/train_models.py --stage final);
# описание модели models/*.json (признаки, настройки) небольшое и хранится в git
models/*
!models/*.json
# архив Kaggle в data/raw/ остаётся в git: ноутбук EDA.ipynb скачивает его с GitHub

# Python и Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Системные файлы
.DS_Store
